# ==============================================================================
# SentinelGate — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure values before starting the application:
#   cp .env.example .env
#
# NOTE: Never commit .env or secrets to version control.
# ==============================================================================

# Database Connection (PostgreSQL with psycopg3 driver)
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg://sentinelgate:change-me@postgres:5432/sentinelgate

# Redis Connection (Rate limiting counters & security event monitoring)
# Format: redis://<host>:<port>/<db>
REDIS_URL=redis://redis:6379/0

# JWT Authentication
# Generate a strong 32+ byte random secret:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-secure-random-32-byte-secret-key-in-production
JWT_EXPIRATION_MINUTES=30

# Rate Limiting Policies
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# PostgreSQL credentials for Docker Compose container initialization
POSTGRES_PASSWORD=change-me-too

# Internal Demo Microservice URL
# Docker Compose network uses 'http://backend:8001'.
# For standalone local development, use 'http://127.0.0.1:8001'.
BACKEND_URL=http://backend:8001

# Optional C++ Aho-Corasick DLP Engine binary path
# In Docker containers, this is set to '/app/dlp-engine'.
# Leave unset or empty for built-in high-performance Python scanner mode.
# DLP_ENGINE_PATH=/app/dlp-engine

# Initial Seed Credentials (used by `python -m app.db.seed`)
ADMIN_PASSWORD=AdminPass!Secure2026
SEED_USER_PASSWORD=UserPass!Secure2026
